# dev | test | prod  (prod: JSON logs, Secure cookies)
ENVIRONMENT=dev

LISTEN_IP=0.0.0.0
LISTEN_PORT=8080
# Comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

PG_HOST=localhost
PG_PORT=5432
PG_USER=goschool
PG_PASSWORD=goschool
PG_DB_NAME=goschool
PG_SSL_MODE=disable
PG_CONN_TIMEOUT=10s

# At least 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h

# Used by `goschool seed-admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Optional bun query logging: 1 = failed queries, 2 = all queries
# BUNDEBUG=2
