    },
    {
      "name": "Courses",
      "description": "Any logged-in user can read courses; only admins can create, update or delete them. Run the Subjects folder first: it creates the subject these courses belong to.",
      "item": [
        {
          "name": "Create course",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('courseName', 'Math 7 ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('courseId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/courses",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_id\": {{subjectId}},\n  \"name\": \"{{courseName}}\",\n  \"status\": \"active\"\n}"
            },
            "description": "`status` is optional (defaults to `active`). The response includes `subject_name`. The id is saved to `courseId`."
