                  "  pm.expect(pm.response.json().code).to.eql('subject_not_found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/courses",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
